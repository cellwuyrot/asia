[Unit]
Description=ASIA BASA web and order notification worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=asia-basa
Group=asia-basa
WorkingDirectory=/srv/asia-basa/packages/web
ExecStart=/usr/local/bin/bun --env-file=/srv/asia-basa/.env /srv/asia-basa/packages/web/src/server.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/asia-basa /var/backups/asia-basa
Environment=XDG_CACHE_HOME=/var/lib/asia-basa/cache
UMask=0077

[Install]
WantedBy=multi-user.target
