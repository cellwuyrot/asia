NODE_ENV=development
WEBSITE_URL=http://localhost:4200
AUTH_TRUSTED_ORIGINS=
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=
BETTER_AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
APPLICATION_ID=
VITE_APPLICATION_ID=
VITE_RUNABLE_AUTH_ISSUER=
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
AUTUMN_SECRET_KEY=

# Server-only. Revoke any token previously shared in chat. Never use VITE_ prefix.
TELEGRAM_BOT_TOKEN=

# Production: WEBSITE_URL=https://asia-basa.ru ; NODE_ENV=production
PORT=4200
HOST=127.0.0.1
# Only exact IPs of YOUR reverse proxy. Never trust arbitrary visitor X-Real-IP/XFF.
TRUSTED_PROXY_IPS=
# Stable server-only secret (32+ random chars); if blank BETTER_AUTH_SECRET is used.
ORDER_GUARD_SECRET=
# Recommended true in production. Requires both Turnstile keys; no bypass if verification fails.
ORDER_CAPTCHA_REQUIRED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Notification queue runs in the persistent Bun process; keep enabled on production.
NOTIFICATION_WORKER_ENABLED=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Exact HTTPS payment provider hostnames (no wildcard); set to the provider actually used.
PAYMENT_ALLOWED_HOSTS=
